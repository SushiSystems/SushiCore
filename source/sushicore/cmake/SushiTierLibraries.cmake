# The tier shared libraries of a layered C++ tree. Every tier is one shared library,
# <prefix>_<tier>_tier, that holds the code of the tier's static modules, linked whole, and
# carries the headers of all its modules. A tier library links the tier below it publicly. Every
# tier has one generated header, <folder>/<tier>_export.hpp, that defines <MACRO>_<TIER>_API.
#
# A link to a module goes through sushi_tier_link(), which resolves it when it is declared: a
# module of the linking target's own tier is kept for its headers only, and a module of another
# tier becomes that tier's library. The code of a module therefore exists once in the process.
# No pass at the end of the configure rewrites the links, so a module comes and goes with its own
# calls. The one order it asks: a module is declared with sushi_tier_module() before a target
# links it.

include_guard(GLOBAL)

# sushi_tier_libraries(PREFIX <prefix> MACRO_PREFIX <macro> TIERS <tier>... [HEADER_FOLDER <folder>])
#   Declares the tiers, lowest first, once per configure, and creates for each its shared library
#   <prefix>_<tier>_tier, with the output name <prefix>_<tier>, and its export header. A static
#   module of a tier compiles with <PREFIX>_BUILDING_<TIER>_TIER, which makes the mark export.
#   The headers sit under <folder>, <prefix>/tier by default, in an include root that the
#   INTERFACE target <prefix>_tier_export carries; every module and tier library links it.
function(sushi_tier_libraries)
    cmake_parse_arguments(ARG "" "PREFIX;MACRO_PREFIX;HEADER_FOLDER" "TIERS" ${ARGN})
    if(ARG_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR
            "sushi_tier_libraries(): unexpected argument(s) '${ARG_UNPARSED_ARGUMENTS}'.")
    endif()
    if(NOT ARG_PREFIX OR NOT ARG_MACRO_PREFIX OR NOT ARG_TIERS)
        message(FATAL_ERROR "sushi_tier_libraries(): PREFIX, MACRO_PREFIX and TIERS are required.")
    endif()
    get_property(is_declared GLOBAL PROPERTY SUSHI_TIER_PREFIX SET)
    if(is_declared)
        get_property(declared GLOBAL PROPERTY SUSHI_TIER_PREFIX)
        message(FATAL_ERROR
            "sushi_tier_libraries(): the tiers of '${declared}' are already declared; a configure "
            "declares its tiers once.")
    endif()
    if(NOT ARG_HEADER_FOLDER)
        set(ARG_HEADER_FOLDER "${ARG_PREFIX}/tier")
    endif()
    foreach(tier IN LISTS ARG_TIERS)
        if(NOT tier MATCHES "^[a-z][a-z0-9_]*$")
            message(FATAL_ERROR
                "sushi_tier_libraries(): the tier '${tier}' is not a lower-case identifier.")
        endif()
    endforeach()

    # The link feature _sushi_tier_archive_item() names. A cache entry, so every directory's
    # targets see it at generation.
    # A feature is one element per library; LINKER: is read only at an element's start, so the
    # driver's own pass-through flag is named. The MSVC front end hands its link line to the
    # linker as it is.
    foreach(lang IN ITEMS C CXX)
        if(CMAKE_${lang}_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
            set(whole "<LIBRARY> /WHOLEARCHIVE:<LIBRARY>")
        else()
            set(whole "<LIBRARY> -Xlinker /WHOLEARCHIVE:<LIBRARY>")
        endif()
        set(CMAKE_${lang}_LINK_LIBRARY_USING_SUSHI_WHOLE_ARCHIVE "${whole}" CACHE INTERNAL "")
        set(CMAKE_${lang}_LINK_LIBRARY_USING_SUSHI_WHOLE_ARCHIVE_SUPPORTED TRUE CACHE INTERNAL "")
    endforeach()

    set(export_root "${CMAKE_CURRENT_BINARY_DIR}/${ARG_PREFIX}_tier_export")
    set_property(GLOBAL PROPERTY SUSHI_TIER_PREFIX "${ARG_PREFIX}")
    set_property(GLOBAL PROPERTY SUSHI_TIER_MACRO_PREFIX "${ARG_MACRO_PREFIX}")
    set_property(GLOBAL PROPERTY SUSHI_TIER_ORDER "${ARG_TIERS}")
    set_property(GLOBAL PROPERTY SUSHI_TIER_INCLUDE_ROOT "${export_root}/include")
    set_property(GLOBAL PROPERTY SUSHI_TIER_HEADER_FOLDER "${ARG_HEADER_FOLDER}")

    add_library(${ARG_PREFIX}_tier_export INTERFACE)
    target_include_directories(${ARG_PREFIX}_tier_export INTERFACE
        "$<BUILD_INTERFACE:${export_root}/include>")

    # A shared library needs one source of its own; the tier's code arrives through the archives.
    # file(CONFIGURE) writes only a changed file, so a configure rebuilds nothing.
    set(anchor "${export_root}/tier_library.cpp")
    file(CONFIGURE OUTPUT "${anchor}"
        CONTENT "// Generated by SushiTierLibraries.cmake: the one source of a tier library.\n")

    string(TOUPPER "${ARG_PREFIX}" prefix_upper)
    set(lower "")
    foreach(tier IN LISTS ARG_TIERS)
        string(TOUPPER "${tier}" tier_upper)
        sushi_tier_export_header(${tier} "${prefix_upper}_BUILDING_${tier_upper}_TIER")
        set(library ${ARG_PREFIX}_${tier}_tier)
        add_library(${library} SHARED "${anchor}")
        set_target_properties(${library} PROPERTIES
            OUTPUT_NAME ${ARG_PREFIX}_${tier}
            POSITION_INDEPENDENT_CODE ON
            CXX_VISIBILITY_PRESET hidden
            VISIBILITY_INLINES_HIDDEN ON)
        target_link_libraries(${library} PUBLIC ${ARG_PREFIX}_tier_export ${lower})
        set(lower ${library})
    endforeach()
endfunction()

# sushi_tier_export_header(<name> <building define>)
#   Writes <folder>/<name>_export.hpp into the tier include root, defining <MACRO>_<NAME>_API: an
#   export where <building define> is set, an import elsewhere on Windows, and default visibility
#   off Windows. sushi_tier_libraries() writes one per tier; a shared library outside the tiers,
#   such as an editor, takes its own mark from it.
function(sushi_tier_export_header name building_define)
    _sushi_tier_setting(SUSHI_TIER_MACRO_PREFIX macro_prefix)
    _sushi_tier_setting(SUSHI_TIER_INCLUDE_ROOT include_root)
    _sushi_tier_setting(SUSHI_TIER_HEADER_FOLDER header_folder)
    string(TOUPPER "${name}" name_upper)
    set(SUSHI_EXPORT_NAME "${name}")
    set(SUSHI_EXPORT_MACRO "${macro_prefix}_${name_upper}_API")
    set(SUSHI_EXPORT_BUILDING "${building_define}")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/SushiTierExport.hpp.in"
        "${include_root}/${header_folder}/${name}_export.hpp" @ONLY)
endfunction()

# sushi_tier_module(<target> <tier>)
#   Declares <target> a module of <tier>. A STATIC module compiles with its tier's building define,
#   position-independent and with hidden visibility, and is linked whole into the tier library.
#   An INTERFACE module compiles nothing, so the tier library holds no code of it. Either way the
#   tier library hands the module's headers to the targets that link it.
function(sushi_tier_module target tier)
    _sushi_tier_setting(SUSHI_TIER_PREFIX prefix)
    _sushi_tier_setting(SUSHI_TIER_ORDER tiers)
    if(NOT TARGET ${target})
        message(FATAL_ERROR "sushi_tier_module(${target} ${tier}): no target of that name exists.")
    endif()
    if(NOT tier IN_LIST tiers)
        message(FATAL_ERROR
            "sushi_tier_module(${target} ${tier}): '${tier}' is not a declared tier; the tiers are "
            "'${tiers}'.")
    endif()
    get_property(declared TARGET ${target} PROPERTY SUSHI_TIER)
    if(NOT "${declared}" STREQUAL "")
        message(FATAL_ERROR
            "sushi_tier_module(${target} ${tier}): the target is already a module of '${declared}'.")
    endif()

    set(library ${prefix}_${tier}_tier)
    get_target_property(type ${target} TYPE)
    if(type STREQUAL "STATIC_LIBRARY")
        string(TOUPPER "${prefix}" prefix_upper)
        string(TOUPPER "${tier}" tier_upper)
        target_compile_definitions(${target} PRIVATE ${prefix_upper}_BUILDING_${tier_upper}_TIER)
        set_target_properties(${target} PROPERTIES
            POSITION_INDEPENDENT_CODE ON
            CXX_VISIBILITY_PRESET hidden
            VISIBILITY_INLINES_HIDDEN ON)
        target_link_libraries(${target} PUBLIC ${prefix}_tier_export)
        target_link_libraries(${library} PRIVATE "$<LINK_LIBRARY:WHOLE_ARCHIVE,${target}>")
    elseif(type STREQUAL "INTERFACE_LIBRARY")
        target_link_libraries(${target} INTERFACE ${prefix}_tier_export)
    else()
        message(FATAL_ERROR
            "sushi_tier_module(${target} ${tier}): a tier module is a STATIC or an INTERFACE "
            "library; this one is ${type}.")
    endif()
    target_link_libraries(${library} INTERFACE "$<COMPILE_ONLY:${target}>")
    set_property(TARGET ${target} PROPERTY SUSHI_TIER "${tier}")
endfunction()

# sushi_tier_link(<target> <PUBLIC|PRIVATE|INTERFACE> <item>...)
#   Links <target> to each item as target_link_libraries() would, with every tier module among them
#   resolved: a module of <target>'s own tier is kept for its headers only, and a module of another
#   tier becomes that tier's library. A module that links a module of a higher tier is refused,
#   since the tier libraries link downwards. A module that links any other item PUBLIC or
#   INTERFACE hands it to the targets of its tier library as well, for their link.
#
#   Both resolutions are made for the target that finally links: one that sushi_tier_archives()
#   marked takes every tier module as its own archive instead, down the whole chain, and links no
#   tier library.
function(sushi_tier_link target scope)
    _sushi_tier_setting(SUSHI_TIER_PREFIX prefix)
    _sushi_tier_setting(SUSHI_TIER_ORDER tiers)
    if(NOT scope MATCHES "^(PUBLIC|PRIVATE|INTERFACE)$")
        message(FATAL_ERROR
            "sushi_tier_link(${target} ${scope}): the scope is PUBLIC, PRIVATE or INTERFACE.")
    endif()
    if(NOT TARGET ${target})
        message(FATAL_ERROR "sushi_tier_link(${target}): no target of that name exists.")
    endif()
    get_property(own_tier TARGET ${target} PROPERTY SUSHI_TIER)
    list(FIND tiers "${own_tier}" own_index)

    set(archives "$<BOOL:$<TARGET_PROPERTY:SUSHI_TIER_ARCHIVES>>")
    set(libraries "$<NOT:${archives}>")
    set(resolved "")
    set(handed_on "")
    foreach(item IN LISTS ARGN)
        set(item_tier "")
        if(TARGET ${item})
            set(named ${item})
            get_target_property(aliased ${item} ALIASED_TARGET)
            if(aliased)
                set(named ${aliased})
            endif()
            get_property(item_tier TARGET ${named} PROPERTY SUSHI_TIER)
        endif()
        if("${item_tier}" STREQUAL "")
            list(APPEND resolved "${item}")
            if(NOT "${own_tier}" STREQUAL "" AND NOT scope STREQUAL "PRIVATE")
                list(APPEND handed_on "$<LINK_ONLY:${item}>")
            endif()
        elseif(item_tier STREQUAL own_tier)
            _sushi_tier_archive_item(${named} archive)
            list(APPEND resolved "$<${libraries}:$<COMPILE_ONLY:${item}>>"
                "$<${archives}:${archive}>")
        else()
            list(FIND tiers "${item_tier}" item_index)
            if(NOT "${own_tier}" STREQUAL "" AND item_index GREATER own_index)
                message(FATAL_ERROR
                    "sushi_tier_link(${target}): the ${own_tier} module ${target} links ${item}, a "
                    "module of the higher tier ${item_tier}; a tier links only the tiers below it.")
            endif()
            _sushi_tier_archive_item(${named} archive)
            list(APPEND resolved "$<${libraries}:${prefix}_${item_tier}_tier>"
                "$<${archives}:${archive}>")
        endif()
    endforeach()

    if(resolved)
        target_link_libraries(${target} ${scope} ${resolved})
    endif()
    if(handed_on)
        target_link_libraries(${prefix}_${own_tier}_tier INTERFACE ${handed_on})
    endif()
endfunction()

# _sushi_tier_archive_item(<module> <out>)
#   Sets <out> to the link item that a target linking the archives takes for <module>. On Windows a
#   STATIC module's archive loads whole: its objects were compiled for its tier library, so a
#   reference to another tier's symbol is an import, and a linker binds an import to a symbol of
#   the program only once that symbol's object is loaded, which an import alone never does. The
#   SUSHI_WHOLE_ARCHIVE feature names the archive on the link line as well as in the linker's
#   whole-archive option, so a SYCL driver still sees it and links its device code, and it stays
#   in the library list that a long link line hands to a response file. Elsewhere a tier library
#   hides no symbol behind an import, and the archive links as it is.
function(_sushi_tier_archive_item module out)
    get_target_property(type ${module} TYPE)
    if(WIN32 AND type STREQUAL "STATIC_LIBRARY")
        set(${out} "$<LINK_LIBRARY:SUSHI_WHOLE_ARCHIVE,${module}>" PARENT_SCOPE)
    else()
        set(${out} "${module}" PARENT_SCOPE)
    endif()
endfunction()

# sushi_tier_archives(<target>...)
#   Marks each target to link the archives of the tier modules it reaches, each whole on Windows
#   (see _sushi_tier_archive_item), and no tier library. A program inside the tree that reaches modules the tier libraries do not export, such
#   as a test or a probe, links this way; its code then exists once in its process, since no tier
#   library is loaded beside it. A program the tree ships links the tier libraries.
function(sushi_tier_archives)
    foreach(target IN LISTS ARGN)
        if(NOT TARGET ${target})
            message(FATAL_ERROR "sushi_tier_archives(${target}): no target of that name exists.")
        endif()
        set_property(TARGET ${target} PROPERTY SUSHI_TIER_ARCHIVES ON)
    endforeach()
endfunction()

# _sushi_tier_setting(<property> <out>)
#   Sets <out> to a setting sushi_tier_libraries() recorded, and stops the configure when the tiers
#   are not declared yet.
function(_sushi_tier_setting property out)
    get_property(value GLOBAL PROPERTY ${property})
    get_property(prefix GLOBAL PROPERTY SUSHI_TIER_PREFIX)
    if("${prefix}" STREQUAL "")
        message(FATAL_ERROR
            "SushiTierLibraries: call sushi_tier_libraries() before declaring or linking a module.")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()
