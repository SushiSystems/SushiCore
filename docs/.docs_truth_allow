cli/config(\.local)?\.toml  # a consuming CLI's config files, which sushicore reads at run time
cli/sushistack\.deps\.toml  # a consuming CLI's dependency manifest, which provisioning reads
\.sushistack/workspace\.toml  # the workspace file hub writes in the user's workspace
services/project\.py  # a consuming CLI's own build policy module
src/styles/global\.css  # the stylesheet of sushiweb, whose palette the default theme takes
docs/design/HUB\.md  # SushiStack's design document
api/xml/index\.xml|pages/guides/.*  # paths inside a documentation bundle
docs/guides/BUILDING\.md  # an example page of the repository being bundled
docs/agent/specs/2026-09-05-hub-design\.md  # a SushiStack document that two docstrings cite, the issue the row records
docs/agent/specs/2026-09-23-provision-design\.md  # the old path a plan cites, the issue the row records
docs/agent/plans/2026-09-25-hub-root-migration\.md  # an untracked plan, the issue the row records
\.pytest_cache|\.superpowers  # folders tools write and git does not track, the issue the row records
chore  # a commit type from the commits skill, not a name in the source
